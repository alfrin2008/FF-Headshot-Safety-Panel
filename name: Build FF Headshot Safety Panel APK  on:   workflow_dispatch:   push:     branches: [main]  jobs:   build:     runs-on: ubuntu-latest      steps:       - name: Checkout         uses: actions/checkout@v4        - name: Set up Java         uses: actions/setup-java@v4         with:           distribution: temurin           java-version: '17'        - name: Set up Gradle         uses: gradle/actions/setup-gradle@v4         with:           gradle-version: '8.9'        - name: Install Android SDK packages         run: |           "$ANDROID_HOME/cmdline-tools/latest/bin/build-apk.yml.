
name: Build FF Headshot Safety Panel APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Install Android SDK packages
        run: |
          "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --install "platforms;android-35" "build-tools;35.0.0"

      - name: Extract project
        run: unzip -o FFHeadshotSafetyPanel-Android-Source.zip

      - name: Build APK
        run: gradle -p FFHeadshotSafetyPanel --no-daemon assembleDebug

      - name: Save APK
        uses: actions/upload-artifact@v4
        with:
          name: FF-Headshot-Safety-Panel-APK
          path: FFHeadshotSafetyPanel/app/build/outputs/apk/debug/app-debug.apk
